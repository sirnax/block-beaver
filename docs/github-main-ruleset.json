{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash", "rebase", "merge"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "Check (Node 22)" },
          { "context": "Check (Node 24)" },
          { "context": "Check (Node 26)" },
          { "context": "Platform (macos-latest)" },
          { "context": "Platform (windows-latest)" },
          { "context": "Dependency audit" },
          { "context": "Gitleaks" },
          { "context": "Analyze (JavaScript and TypeScript)" }
        ]
      }
    }
  ]
}
